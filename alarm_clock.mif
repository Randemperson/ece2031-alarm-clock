-- Altera Memory Initialization File (MIF)

DEPTH = 2048;
WIDTH = 16;

ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT
  BEGIN
    [000..7FF] : 0000;  -- Default to NOP

            000 : 081D;  -- LOAD   Time0659
            001 : 9870;  -- OUT    AC_Time          ; also resets seconds to 00
            002 : 081E;  -- LOAD   Time0700
            003 : 9875;  -- OUT    AC_Alarm0        ; alarm 0 hours/minutes
            004 : 1800;  -- LOADI  0
            005 : 9876;  -- OUT    AC_Alarm0Sec     ; alarm 0 seconds = 00
            006 : 1800;  -- LOADI  0
            007 : 9873;  -- OUT    AC_AlarmSel      ; select alarm 0
            008 : 0822;  -- LOAD   SetEn
            009 : 9874;  -- OUT    AC_AlarmSet      ; enable alarm 0
            00A : 081F;  -- LOAD   GEnFast
            00B : 9872;  -- OUT    AC_GCtrl         ; global enable + fast mode
            00C : 9070;  -- IN     AC_Time
            00D : 9804;  -- OUT    Hex0
            00E : 9071;  -- IN     AC_Sec
            00F : 9805;  -- OUT    Hex1
            010 : 9074;  -- IN     AC_AlarmSet      ; read side of Alarm Settings is the status
            011 : 3825;  -- AND    StAnyRinging
            012 : 700C;  -- JZERO  Poll
            013 : 0827;  -- LOAD   AllLEDs
            014 : 9801;  -- OUT    LEDs
            015 : 9000;  -- IN     Switches
            016 : 3828;  -- AND    SwitchMask
            017 : 7015;  -- JZERO  WaitForSwitch
            018 : 0820;  -- LOAD   GResetKeep       ; RESET all alarms, keep EN and FAST set
            019 : 9872;  -- OUT    AC_GCtrl
            01A : 1800;  -- LOADI  0
            01B : 9801;  -- OUT    LEDs
            01C : 581C;  -- JUMP   Done
            01D : 0659;  -- Time0659:    DW &H0659
            01E : 0700;  -- Time0700:    DW &H0700
            01F : 0005;  -- GEnFast:     DW &B0101
            020 : 0007;  -- GResetKeep:  DW &B0111
            021 : 000D;  -- GClearKeep:  DW &B1101
            022 : 0001;  -- SetEn:       DW &B01
            023 : 0003;  -- SetResetEn:  DW &B11
            024 : 0002;  -- StRinging:   DW &B0010
            025 : 0004;  -- StAnyRinging: DW &B0100
            026 : 0008;  -- StError:     DW &B1000
            027 : 03FF;  -- AllLEDs:     DW &B1111111111
            028 : 0001;  -- SwitchMask:  DW &H0001
END;
